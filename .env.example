# Session pooler (porta 5432) — Drizzle Kit e o servidor Node
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Magites Opressoras usa o schema Postgres `resource_balance` (o portfólio fica em `public`).
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=

# E-mail que herda os cenários já existentes (Magite). Deixe vazio para o primeiro cadastro receber.
OWNER_EMAIL=

# No Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# DATABASE_URL e OWNER_EMAIL são usadas só no servidor (API). Não exponha no frontend.
#
# Deploy: Framework "Other", Root Directory na raiz do repositório.
# Depois do primeiro deploy, rode `pnpm db:push` (e `pnpm db:seed` se quiser) contra o mesmo DATABASE_URL.
